# /opt/gexbot/gexbot.env      chmod 600
# All times are CENTRAL.

GEXBOT_HOME=/opt/gexbot/data

# ── symbols ──────────────────────────────────────────────────────────
GEXBOT_SYMBOLS=SPY,QQQ

# ── expiry / DTE ─────────────────────────────────────────────────────
# Which expiry to TRADE. 0 = same day, 1 = next session, 7 = a week out.
# Never resolves shorter than requested — asking for 3 on a Friday gets you
# Monday, not that afternoon.
GEXBOT_TRADE_DTE=1

# Which expiries feed the MAP. Near-dated gamma drives intraday hedging
# pressure whatever you hold, so aggregate the front expiries regardless of
# what you trade.
GEXBOT_MAP_DTE_MAX=7

# Required for TRADE_DTE > 0, otherwise the 14:30 force-flat closes it same day.
GEXBOT_HOLD_OVERNIGHT=yes

# ── authorization ────────────────────────────────────────────────────
# The daemon holds its own OAuth grant — a Claude connector authorizes Claude,
# not this process. Authorize once with:  gexbot.py --login
# Tokens land in $GEXBOT_HOME/oauth (0600) and refresh silently after that.
#
# Port the browser redirect comes back on. Forward it from the machine running
# the browser:  ssh -L 8788:127.0.0.1:8788 root@your-vps
GEXBOT_OAUTH_PORT=8788
# Leave blank unless you know Robinhood's exact scope strings; blank means the
# server applies its default grant.
GEXBOT_OAUTH_SCOPE=

# ── account ──────────────────────────────────────────────────────────
# Only needed when arming. --login prints the account numbers it can see.
GEXBOT_ACCOUNT=
# Drives position sizing: 1% of this is risked per trade.
GEXBOT_ACCOUNT_VALUE=25000

# ── risk ─────────────────────────────────────────────────────────────
# Halt for the rest of the day past this realized loss.
GEXBOT_DAILY_STOP=500
# Leave blank to derive from spot and DTE (recommended).
# GEXBOT_SPREAD_WIDTH=
# GEXBOT_ITM_OFFSET=

# ── dashboard ────────────────────────────────────────────────────────
GEXBOT_DASH_PORT=8787
# 127.0.0.1 = this machine only. Use an SSH tunnel or Tailscale to reach it.
# Setting 0.0.0.0 REQUIRES a token — serve() refuses otherwise.
GEXBOT_DASH_HOST=127.0.0.1
GEXBOT_DASH_TOKEN=

# ── alerts ───────────────────────────────────────────────────────────
GEXBOT_ALERT_EMAIL=
GEXBOT_SMTP_HOST=smtp.gmail.com
GEXBOT_SMTP_USER=
GEXBOT_SMTP_PASS=

# ── arming ───────────────────────────────────────────────────────────
# Live trading needs BOTH this line uncommented AND --live on the command
# line. Two switches, on purpose. Leave it commented until the paper log
# says something the 56-session sample couldn't.
# GEXBOT_ARMED=yes
